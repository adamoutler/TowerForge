FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    DEV_SERVER_PORT=8096 \
    ADB_SERVER_SOCKET=tcp:127.0.0.1:5037 \
    ANDROID_SERIAL=54221FDAP0011M

RUN apt-get update && apt-get install -y --no-install-recommends \
    adb \
    android-sdk-platform-tools-common \
    ca-certificates \
    curl \
    git \
    procps \
    python3 \
    python3-pytest \
    && rm -rf /var/lib/apt/lists/* \
    && git config --system --add safe.directory /workspace

WORKDIR /workspace

EXPOSE 8096 47821

CMD ["sh", "-c", "cd /workspace/towerforge.client && if [ ! -d node_modules ]; then npm ci && chown -R 1000:126 node_modules; fi && exec npm run dev -- --host 0.0.0.0 --port 8096"]
